# OneOnOne backend — полный список переменных окружения.
#
# Здесь только имена и плейсхолдеры. Реальные значения задаются ТОЛЬКО в панели
# хостинга (Timeweb App Platform → Переменные) и НИКОГДА не коммитятся.
# Файл .env добавлен в .gitignore.
#
# Секретов со значением по умолчанию в коде нет: если обязательная переменная не
# задана, приложение сообщает об ошибке конфигурации, а не работает молча на
# зашитом значении. Зашитый в код секрет публичен по определению — он попадает и
# в репозиторий, и в сборку, и в историю git.
#
# Легенда: [ОБЯЗАТЕЛЬНО] — без неё соответствующая часть продукта не работает.
#          [СЕКРЕТ] — значение секретное, обращаться как с паролем.

# ─────────────────────────────────────────────────────────────────────────────
# База данных
# ─────────────────────────────────────────────────────────────────────────────
# [ОБЯЗАТЕЛЬНО] [СЕКРЕТ] Строка подключения PostgreSQL. Без неё приложение не
# стартует (app/database.py: RuntimeError "DATABASE_URL is not set").
DATABASE_URL=postgresql://your_db_user:your_db_password_here@your_db_host:5432/your_db_name

# ─────────────────────────────────────────────────────────────────────────────
# Криптография и сессии
# ─────────────────────────────────────────────────────────────────────────────
# [ОБЯЗАТЕЛЬНО] [СЕКРЕТ] Корневой серверный секрет. Из него выводятся ключи
# шифрования OAuth-токенов календарей (app/services/crypto.py). Пустое значение
# = ошибка конфигурации, дефолта нет.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# [ОБЯЗАТЕЛЬНО] [СЕКРЕТ] Ключ подписи JWT (HS256). Если не задан, берётся
# SECRET_KEY; если пусты оба — вход не работает (ошибка конфигурации).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here
# Срок жизни токена сессии в днях.
JWT_EXPIRE_DAYS=30
# Принудительная проверка JWT на всех непубличных эндпоинтах (1 = включено).
AUTH_ENFORCE=0

# ─────────────────────────────────────────────────────────────────────────────
# Админ-панель
# ─────────────────────────────────────────────────────────────────────────────
# [СЕКРЕТ] Пароль входа в админ-панель (проверяется только на сервере,
# POST /api/auth/admin-login). Дефолта нет: пока не задан, вход в админку
# отдаёт 503. В клиентах (веб, приложение) пароля нет.
ADMIN_PASSWORD=your_admin_password_here
# [СЕКРЕТ] Опционально: сервис-токен для машинного доступа к админ-эндпоинтам
# через заголовок X-Admin-Token.
ADMIN_API_TOKEN=your_admin_api_token_here

# ─────────────────────────────────────────────────────────────────────────────
# Сеть и клиенты
# ─────────────────────────────────────────────────────────────────────────────
# Порт HTTP-сервера (на Timeweb — 8080).
PORT=8080
# Базовый URL веб-кабинета: ссылки в письмах, из бота, redirect URI по умолчанию.
APP_WEB_URL=https://your-web-app.example
# Разрешённые источники CORS через запятую, без слеша в конце.
CORS_ORIGINS=https://your-web-app.example

# ─────────────────────────────────────────────────────────────────────────────
# Очереди (Celery / Redis)
# ─────────────────────────────────────────────────────────────────────────────
# [СЕКРЕТ, если managed-Redis с паролем]
REDIS_URL=redis://localhost:6379/0
# Опционально: если брокер и backend результатов разные адреса.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─────────────────────────────────────────────────────────────────────────────
# Почта (SMTP) — подтверждение email и сброс пароля
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.your-mail-provider.example
SMTP_PORT=465
SMTP_USER=your_smtp_user_here
# [СЕКРЕТ]
SMTP_PASSWORD=your_smtp_password_here
SMTP_ENCRYPTION=SSL
SMTP_FROM=noreply@your-domain.example

# ─────────────────────────────────────────────────────────────────────────────
# Безопасность входа (email/пароль)
# ─────────────────────────────────────────────────────────────────────────────
# Код подтверждения по email при КАЖДОМ входе по email/паролю (не регистрация).
# Если пусто/0 — код всё равно включается автоматически, когда настроен SMTP
# (см. выше): почта работает => код можно доставить. Явная «1» форсирует режим,
# «0» его НЕ отключает при рабочем SMTP. Не влияет на вход через Yandex/VK/Telegram.
LOGIN_EMAIL_CODE=1
# Капча Яндекс SmartCaptcha. Если задан серверный ключ — проверка капчи на входе
# СТРОГО ОБЯЗАТЕЛЬНА (запрос без валидного токена отклоняется на бэкенде).
# [СЕКРЕТ] Серверный ключ (validate). Пусто => капча не требуется.
CAPTCHA_SERVER_KEY=your_yandex_smartcaptcha_server_key
# Клиентский ключ (виджет). Публичный, попадает в браузер.
CAPTCHA_CLIENT_KEY=your_yandex_smartcaptcha_client_key

# ─────────────────────────────────────────────────────────────────────────────
# AI Gateway (OpenAI-совместимый шлюз) — единый провайдер всех AI-функций
# ─────────────────────────────────────────────────────────────────────────────
# [СЕКРЕТ] Без ключа AI-функции возвращают явную ошибку конфигурации.
# Скрытого дефолтного ключа в коде нет.
AI_GATEWAY_KEY=your_ai_gateway_key_here
AI_GATEWAY_BASE_URL=https://api.timeweb.ai/v1
# Модель для ВСЕХ AI-функций (Timeweb AI Gateway). Ключ и base_url при смене
# модели не меняются — меняется только имя модели и цены за токен ниже.
AI_GATEWAY_MODEL=xai/grok-4.3
# Цена за 1 млн токенов в рублях у используемого провайдера/модели — для учёта
# AI-себестоимости (provider-agnostic: логика расчёта не меняется, только числа).
# По умолчанию — тарифы Grok 4.3 (Timeweb AI Gateway).
AI_PRICE_INPUT_RUB_PER_MTOK=169
AI_PRICE_OUTPUT_RUB_PER_MTOK=338

# ─────────────────────────────────────────────────────────────────────────────
# Telegram-бот
# ─────────────────────────────────────────────────────────────────────────────
# [СЕКРЕТ] Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Публичное имя бота без @ (например, oneononehq_bot).
TELEGRAM_BOT_USERNAME=your_bot_username_here
# [СЕКРЕТ] Секрет заголовка вебхука. Если не задан, выводится из токена бота.
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
# Режим получения апдейтов: webhook | polling
TELEGRAM_MODE=polling
# Deep-link возврата в приложение после входа через Telegram (не секрет).
# Login Widget работает только в браузере, поэтому мобильный вход идёт через
# веб-мост /auth/telegram/callback?platform=mobile, а бэкенд перебрасывает JWT
# в приложение по этой схеме.
TELEGRAM_MOBILE_REDIRECT_URI=oneonone://auth/telegram/callback

# ─────────────────────────────────────────────────────────────────────────────
# Платежи (CloudPayments; провайдер подключается через PAYMENT_PROVIDER)
# ─────────────────────────────────────────────────────────────────────────────
# Действующий провайдер. Задел под будущие: freedompay, stripe.
PAYMENT_PROVIDER=cloudpayments
# Public ID виджета (не секрет, уходит на фронт).
CLOUDPAYMENTS_PUBLIC_ID=your_cloudpayments_public_id_here
# [СЕКРЕТ] Пароль API. Тестовые и боевые ключи задаются одними и теми же
# переменными — тестовых значений в коде нет.
CLOUDPAYMENTS_API_SECRET=your_cloudpayments_api_secret_here
# [СЕКРЕТ] Отдельный секрет для HMAC вебхуков, если заведён; иначе берётся
# CLOUDPAYMENTS_API_SECRET.
CLOUDPAYMENTS_WEBHOOK_HMAC=your_cloudpayments_webhook_hmac_here
# Дней отсрочки после неудачного списания до блокировки платных функций.
BILLING_GRACE_DAYS=3
# Принудительная проверка тарифных лимитов (1 = включено).
ENTITLEMENTS_ENFORCE=0

# ─────────────────────────────────────────────────────────────────────────────
# Интеграция с календарями (OAuth). Отдельно от входа через Yandex ID.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
# [СЕКРЕТ]
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-web-app.example/integrations/google/callback

YANDEX_CLIENT_ID=your_yandex_calendar_client_id_here
# [СЕКРЕТ]
YANDEX_CLIENT_SECRET=your_yandex_calendar_client_secret_here
YANDEX_REDIRECT_URI=https://your-web-app.example/integrations/yandex/callback

# Куда вернуть пользователя после OAuth-колбэка. По умолчанию APP_WEB_URL.
INTEGRATIONS_RETURN_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Вход через Yandex ID (регистрация/вход, ОТДЕЛЬНОЕ приложение Yandex OAuth)
# ─────────────────────────────────────────────────────────────────────────────
YANDEX_LOGIN_CLIENT_ID=your_yandex_login_client_id_here
# [СЕКРЕТ]
YANDEX_LOGIN_CLIENT_SECRET=your_yandex_login_client_secret_here
# Redirect URI веба. По умолчанию APP_WEB_URL + /auth/yandex/callback.
YANDEX_LOGIN_REDIRECT_URI=https://your-web-app.example/auth/yandex/callback
# Deep-link возврата в приложение (не секрет).
YANDEX_LOGIN_MOBILE_REDIRECT_URI=oneonone://auth/yandex/callback

# ─────────────────────────────────────────────────────────────────────────────
# Вход через VK ID (регистрация/вход). Обмен кода на токен — на бэкенде.
# ─────────────────────────────────────────────────────────────────────────────
# App ID приложения VK ID (публичный, уходит на фронт для инициализации SDK).
VK_APP_ID=your_vk_app_id_here
# [СЕКРЕТ] Защищённый ключ приложения VK ID. Только окружение, в бандл не кладём.
VK_CLIENT_SECRET=your_vk_client_secret_here
# Redirect URI веба. По умолчанию APP_WEB_URL + /auth/vk/callback. Должен точь-в-
# точь совпадать с адресом, зарегистрированным в приложении VK ID.
VK_LOGIN_REDIRECT_URI=https://app.oneononehq.com/auth/vk/callback
# Deep-link возврата в приложение (не секрет).
VK_LOGIN_MOBILE_REDIRECT_URI=oneonone://auth/vk/callback
# Домен VK ID для виджета и серверного обмена кода. Пусто => id.vk.ru (дефолт
# @vkid/sdk). Переключить на id.vk.com можно одной этой переменной, если так
# зарегистрировано приложение / если .ru недоступен.
VK_ID_DOMAIN=id.vk.ru

# ─────────────────────────────────────────────────────────────────────────────
# DaData — поиск компании по ИНН/БИН
# ─────────────────────────────────────────────────────────────────────────────
# [СЕКРЕТ] Ключ хранится только на сервере; фронт ходит через наш прокси.
# Без ключа поиск отдаёт пустой список, а UI предлагает ручной ввод.
DADATA_API_KEY=your_dadata_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Яндекс Облако: расшифровка записей звонков (SpeechKit + Object Storage)
# ─────────────────────────────────────────────────────────────────────────────
# [СЕКРЕТ]
YANDEX_SPEECHKIT_KEY=your_yandex_speechkit_key_here
YANDEX_BUCKET_KEY_ID=your_yandex_bucket_key_id_here
# [СЕКРЕТ]
YANDEX_BUCKET_KEY_SECRET=your_yandex_bucket_key_secret_here
YANDEX_BUCKET_NAME=your_bucket_name_here

# ─────────────────────────────────────────────────────────────────────────────
# Поведение продукта (не секреты)
# ─────────────────────────────────────────────────────────────────────────────
# Порог анонимности статистики настроения команды.
MOOD_ANON_THRESHOLD=3
# Часовой пояс по умолчанию для команд без явного timezone.
DEFAULT_TIMEZONE=Europe/Moscow
# Региональные цены. Функции в продукте нет — оставлять выключенной.
REGION_PRICING_ENABLED=0
# Путь к локальной базе GeoIP (используется только при REGION_PRICING_ENABLED=1).
GEOIP_DB_PATH=

# Входные данные метрик для инвесторского дашборда (CAC / LTV / ROI).
MARKETING_SPEND_KOPECKS=0
NEW_PAID_CUSTOMERS=0
MONTHLY_CHURN=0.05
ROI_HOURLY_RATE_KOPECKS=0
ROI_SAVED_HOURS_PER_MEETING=0.5

# Разрушительные dev-эндпоинты (reset-db). Только для локальной разработки.
ENABLE_DEV_ENDPOINTS=0
